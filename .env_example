###############################################################################
# 파일명을 .env로 바꾸어 사용합니다.
# ClassifierConfig.from_env(reload_dotenv=True)를 통해 주피터 커널 재시작 없이도 즉시 반영됩니다.
###############################################################################

# 1. 기준 해상도(1280x720) 및 30fps H.264(1.00) 기준 목표 비트레이트 설정 (단위: kbps, 기본값: 1500)
BASE_RESOLUTION_WIDTH=1280
BASE_RESOLUTION_HEIGHT=720
BASE_TARGET_BITRATE=1500

# 2. 임의 해상도(360p ~ 1080p, 2K, 4K+)에 대한 비선형 픽셀 면적 지수 (기본값: 0.82)
#    및 30fps 초과 고주사율 영상에 대한 프레임레이트 비선형 보정 지수 (기본값: 0.60)
AREA_SCALING_EXPONENT=0.82
FPS_SCALING_EXPONENT=0.60
BASE_FPS=30.0

# 3. H.264(1.00) 기준 코덱별 상대 적정 비트레이트 가중치 (동일 체감 화질 달성 기준)
CODEC_WEIGHT_AV1=0.65
CODEC_WEIGHT_HEVC_VP9=0.80
CODEC_WEIGHT_H264=1.00
CODEC_WEIGHT_LEGACY=1.30

# 4. 해상도 및 코덱별 최적 비트레이트(B_opt) 대비 화질 3구간 판별 경계 배수
#    - 과화질 경계 배수 (기본값: 1.2 -> 720p H.264 기준 1500 * 1.2 = 1800 kbps 초과 시 과화질로 판정)
#    - 저화질 경계 배수 (기본값: 0.8 -> 720p H.264 기준 1500 * 0.8 = 1200 kbps 미만 시 저화질로 판정)
THRESHOLD_OPTIMAL_BITRATE_RATE=1.2
THRESHOLD_LOW_BITRATE_RATE=0.8

# 5. 최대 허용 키프레임 간격 (단위: 초, 기본값: 2.2초 -> 초과 시 1초 키프레임 교정 대상으로 분류)
THRESHOLD_KEYFRAME_INTERVAL=2.2

# 6. 소형 영상(Footage) 분포 분석 및 누적 최적화(Cumulative Optimization) 판별 설정
#    - SMALL_FOOTAGE_SIZE_MB: 소형 영상 기준 용량 (기본값: 30.0 MB)
#    - SMALL_FOOTAGE_MIN_SAVED_MB: 개별 파일 최소 절감 하한선 (기본값: 3.0 MB)
#    - SMALL_FOOTAGE_CUMULATIVE_RATIO: 전체 절감 가능량 중 소형 영상 비중 임계값 (기본값: 0.15 = 15%)
#    - SMALL_FOOTAGE_CUMULATIVE_MB: 소형 영상 절감 가능 합계 임계값 (기본값: 500.0 MB)
SMALL_FOOTAGE_SIZE_MB=30.0
SMALL_FOOTAGE_MIN_SAVED_MB=3.0
SMALL_FOOTAGE_CUMULATIVE_RATIO=0.15
SMALL_FOOTAGE_CUMULATIVE_MB=500.0

# 7. 키프레임 1초 교정 시 I-프레임 증가에 따른 자연스러운 용량 증가율 계수 (기본값: 0.06)
KEYFRAME_1S_OVERHEAD_RATE=0.06

# 8. 퀄리티 기반 통합 인코딩 타겟 폴더명 설정
DIR_STANDARD_CQ22=_1_표준인코딩_CQ22
DIR_LOW_QUALITY_KEYFRAME=_2_저화질_키프레임교정

# 9. 출력 테이블 형식 지정
TABULATE_FLOATFMT=.3f
TABULATE_FILENAME_MAXLEN=80
